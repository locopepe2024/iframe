# 阿里云 DashScope API Key (用于通义千问等模型)
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 阿里云 Access Key (用于 OSS、视频超分等服务)
ALIBABA_CLOUD_ACCESS_KEY_ID=your_aliyun_access_key_id_here
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_aliyun_access_key_secret_here

# OSS 配置 (可选，用于图片/视频存储)
OSS_BUCKET_NAME=your_bucket_name
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BASE_PATH=comic_gen/

# Kling AI 配置 (可选，用于 Kling 视频生成)
KLING_ACCESS_KEY=your_kling_access_key_here
KLING_SECRET_KEY=your_kling_secret_key_here

# Vidu AI 配置 (可选，用于 Vidu 视频生成)
VIDU_API_KEY=your_vidu_api_key_here

# MuleRun / MuleRouter 配置 (可选，用于 Seedance 2.0 视频生成 + GPT-Image-2 图片生成)
# 方式一 (推荐): 安装 MuleRun CLI 并登录，然后从 mulerun studio config 获取 key
#   npm i -g @mulerunai/cli && mulerun login
#   mulerun studio config  → 复制 API Key (格式: muk-...)
# 方式二: 直接用 MuleRouter API Key
# 两种 key 格式通用，填入同一变量即可：
# MULEROUTER_API_KEY=muk-your-key-here
# 站点选择 (mulerouter=默认, mulerun=更多模型但 gpt-image-2 仅 mulerouter 可用)
# MULEROUTER_SITE=mulerouter

# LLM 多模型适配 (可选)
# 默认使用 DashScope (通过 OpenAI 兼容接口调用，只需上方 DASHSCOPE_API_KEY 即可)
# LLM_PROVIDER=dashscope
#
# 如需切换到第三方 OpenAI 兼容 API (OpenAI/DeepSeek/Ollama 等):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
#
# DeepSeek 示例:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_deepseek_api_key
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
#
# 本地 Ollama 示例:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=ollama

# Multi-user identity and owner-scoped configuration
# LUMENX_IDENTITY_BASE_URL=https://canvas.uniart.fun
# Required in production. Use a stable high-entropy secret and keep it unchanged.
# LUMENX_CONFIG_MASTER_KEY=replace-with-a-long-random-secret
# Optional separate signing key for protected Playground media URLs.
# LUMENX_MEDIA_SIGNING_KEY=replace-with-another-long-random-secret
# Optional public backend origin for providers that should read media from the
# iFrame disk instead of COS/OSS. The origin must be reachable by UniArt and
# the signed /studio/media route must be exposed by the deployment.
# UNIART_MEDIA_BASE_URL=https://your-iframe-backend.example.com
# Shared process credentials are disabled by default for user generation.
# LUMENX_ALLOW_SHARED_PROVIDER_CREDENTIALS=false
# Global .env editing is disabled by default in multi-user mode.
# LUMENX_ENABLE_ADMIN_ENV_CONFIG=false
# Required in addition to the flag when an operator deliberately enables it.
# LUMENX_ADMIN_CONFIG_TOKEN=replace-with-a-separate-admin-secret
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:72b

# API 服务配置
API_HOST=0.0.0.0
API_PORT=8000

# ===============================
# API 端点配置 (可选，海外部署时切换到国际端点)
# 命名约定: {PROVIDER}_BASE_URL
# ===============================
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com
# KLING_BASE_URL=https://api.klingai.com/v1
# VIDU_BASE_URL=https://api.vidu.cn/ent/v2
# MULEROUTER_BASE_URL=https://api.mulerouter.ai
